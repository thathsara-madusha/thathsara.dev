---
const title = Astro.props.title ?? 'Thathsara Madusha - Software Engineer';
const description =
  'Software engineer & DevOps — Go, Rust and TypeScript backends to Kubernetes infrastructure. Building at the intersection of systems and cloud.';
const site = 'https://thathsara.dev';
const ogImage = `${site}/og.png`;

const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Thathsara Madusha',
  url: site,
  jobTitle: 'Software Engineer',
  worksFor: { '@type': 'Organization', name: 'WSO2' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Colombo School of Computing' },
  email: 'mailto:thathsaramadhhusha@gmail.com',
  sameAs: [
    'https://github.com/nova9',
    'https://www.linkedin.com/in/thathsara-m',
    'https://thathsara.lk',
  ],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content="Astro" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site + Astro.url.pathname} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="thathsara.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site + Astro.url.pathname} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={personSchema} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
