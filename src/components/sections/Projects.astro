---
import { projects } from '../../lib/data';
---

<section class="ws ws-projects" data-ws="projects">
  <div class="section-head">
    <h2>projects.ml</h2>
    <span class="crumb">projects/</span>
    <span class="badge">5 active · 12 archived</span>
  </div>
  <div class="project-list">
    {projects.map((p) => (
      <article class="proj">
        <div class="proj-info">
          <div class="proj-head">
            <span class="num">{p.n}</span>
            <h3><a href="#" onclick="event.preventDefault()">{p.name}</a></h3>
            <span class="tags">
              {p.tags.map((t) => <span class={`tag ${t}`}>{t}</span>)}
            </span>
          </div>
          <p class="proj-desc">{p.blurb}</p>
          <div class="proj-meta">
            <span>lang · <b>{p.lang}</b></span>
            <span>shipped · <b>{p.year}</b></span>
            <span>★ <b>{p.stars}</b></span>
            <span>stack · <b>{p.stack.slice(0, 3).join(' · ')}</b>{p.stack.length > 3 ? ` +${p.stack.length - 3}` : ''}</span>
          </div>
        </div>
        <div class="proj-demo">
          <div class="label">// live</div>
          <pre style="margin: 0; font-family: inherit; color: var(--fg-soft); white-space: pre-wrap; font-size: 10.5px;">{p.demo}</pre>
          <div style="margin-top: auto; padding-top: 12px; display: flex; gap: 12px; font-size: 10.5px;">
            {p.github
              ? <a href={p.github} target="_blank" rel="noopener" style="color: var(--amber)">↗ github</a>
              : <span style="color: var(--fg-faint)">↗ github</span>
            }
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
