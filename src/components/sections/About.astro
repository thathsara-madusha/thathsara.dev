---
import { identity, bio } from '../../lib/data';

const ASCII_PORTRAIT = `        \u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592        
     \u2592\u2592\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2592\u2592     
   \u2592\u2592\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2592\u2592   
  \u2592\u2591\u2591\u2591\u2591\u2593\u2593\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2593\u2593\u2591\u2591\u2591\u2591\u2592  
  \u2592\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2592  
  \u2592\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2588\u2588\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2592  
  \u2592\u2591\u2591\u2591\u2591\u2591\u2591\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2591\u2591\u2591\u2591\u2592  
   \u2592\u2592\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2592\u2592   
     \u2592\u2592\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2592\u2592     
    \u2593\u2593\u2593\u2593\u2593\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2593\u2593\u2593\u2593\u2593    `;
---

<section class="ws ws-about" data-ws="about">
  <div class="section-head">
    <h2>about</h2>
    <span class="crumb">whoami.md</span>
    <span class="badge">active</span>
  </div>
  <div class="about-grid">
    <div class="about-bio">
      <p class="lead">{bio.lead}</p>
      {bio.paragraphs.map((p) => <p set:html={p} />)}
      <p style="color: var(--fg-mute); font-size: 12px; margin-top: 2em;">
        ✦ Otherwise: homelab tinkering at odd hours, a half-finished research paper about TCP SYN packets, and coffee.
        Open to internships, weird collaborations, and projects that ship.
      </p>
    </div>
    <div class="profile-card">
      <div class="hdr"><span>profile.json</span><span class="ok">verified</span></div>
      <div class="grid">
        <span class="k">name</span><span class="v">{identity.name}</span>
        <span class="k">handle</span><span class="v">@{identity.github}</span>
        <span class="k">role</span><span class="v">{identity.role}</span>
        <span class="k">loc</span><span class="v">{identity.location} · {identity.timezone}</span>
        <span class="k">status</span><span class="v"><span class="badge" style="color: var(--mint)">shipping</span></span>
        <span class="k">stack</span>
        <span class="v">
          <span class="badge">go</span><span class="badge">ts</span><span class="badge">php</span><span class="badge">py</span>
        </span>
        <span class="k">domains</span>
        <span class="v">
          <span class="badge" style="color: var(--mint)">web</span><span class="badge" style="color: var(--amber)">devops</span><span class="badge" style="color: var(--azure)">ai</span>
        </span>
        <span class="k">pgp</span><span class="v" style="color: var(--mint); font-size: 10.5px;">{identity.pgp}</span>
      </div>
      <pre class="ascii">{ASCII_PORTRAIT}</pre>
    </div>
  </div>
</section>
