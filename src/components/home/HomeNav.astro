---
import Arrow from "../icons/Arrow.astro";

const items = [
  { id: "top", label: "intro" },
  { id: "work", label: "work" },
  { id: "path", label: "experience" },
  { id: "contact", label: "contact" },
];
---

<nav class="nav">
  <div class="brand-group">
    <a class="brand" href="#top">
      <span class="dot"></span>
      <span>thathsara<span class="ext">.dev</span></span>
    </a>
    <a class="resume" href="/resume.pdf" target="_blank" rel="noopener">
      resume <Arrow size={12} />
    </a>
  </div>

  <button
    class="nav-toggle"
    id="navToggle"
    type="button"
    aria-label="Open navigation"
    aria-expanded="false"
    aria-controls="navLinks"
  >
    <span></span><span></span><span></span>
  </button>

  <div class="links" id="navLinks">
    {items.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
  </div>
</nav>
