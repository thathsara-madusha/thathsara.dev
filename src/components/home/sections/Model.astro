<section id="experiments" class="panel model-experiment">
  <h2>How the figure was made.</h2>
  <p>
    The figure was generated with{" "}
    <a
      href="https://github.com/TencentARC/Pixal3D"
      target="_blank"
      rel="noopener">Pixal3D</a
    >, running it on an NVIDIA L40 GPU rented from{" "}
    <a href="https://runpod.io" target="_blank" rel="noopener">RunPod</a>.
  </p>
  <figure class="gpu-shot gpu-composite">
    <img
      class="gpu-main"
      src="/l40.webp"
      alt="NVIDIA L40 GPU"
      width="2220"
      loading="lazy"
      decoding="async"
    />
    <img
      class="glass-inset"
      src="/glass.avif"
      alt="Violet holographic study of the point-cloud portrait"
      width="7524"
      height="7524"
      loading="lazy"
      decoding="async"
    />
