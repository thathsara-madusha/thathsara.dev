    </figcaption>
  </figure>
  <div class="builtwith">
    <span class="builtwith-label">built on</span>
    <div class="logos">
      <span class="logo gpu">
        <img src="/icons/nvidia.svg" alt="NVIDIA" width="28" height="20" />
