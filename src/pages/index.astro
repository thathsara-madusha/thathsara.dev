---
import Layout from "../layouts/Layout.astro";
import ModelCloud from "../components/islands/ModelCloud.svelte";

const nav = [
  { id: "top", label: "intro" },
  { id: "about", label: "about" },
  { id: "focus", label: "focus" },
  { id: "work", label: "work" },
  { id: "path", label: "path" },
  { id: "contact", label: "contact" },
];

const focus = [
  {
    k: "engineering",
    d: "Building software end to end — from Go and Rust backends to React/TypeScript interfaces. I care about the details most people skip past.",
    tags: ["Go", "Rust", "TypeScript"],
  },
  {
    k: "systems & cloud",
    d: "Designing the moving parts so they actually fit: clear interfaces, sensible data, and infrastructure you can reason about.",
    tags: ["Kubernetes", "Terraform", "AWS"],
  },
  {
    k: "reliability",
    d: "Shipping is the start, not the finish. I like the unglamorous DevOps work that makes things observable, testable, and hard to break.",
    tags: ["Observability", "CI/CD", "Grafana"],
  },
];

const work = [
  {
    n: "01",
    title: "Seer",
    desc: "A GPT-style transformer language model built end to end in Rust on HuggingFace's Candle — BPE tokenizer, multi-head causal self-attention, and the full training pipeline from scratch.",
    meta: ["Rust", "Candle", "ML"],
  },
  {
    n: "02",
    title: "CareerSync",
    desc: "A cloud-native recruitment platform that processed 12,000+ résumé PDFs with OpenAI — scalable architecture deployed on Kubernetes via Terraform.",
    meta: ["React", "Laravel", "Kubernetes"],
  },
  {
    n: "03",
    title: "Home Lab",
    desc: "A self-hosted infrastructure lab exposed to the public internet — a Kubernetes cluster behind Nginx with TLS, monitored live on Grafana & Prometheus.",
    meta: ["Kubernetes", "Nginx", "Prometheus"],
  },
];

const path = [
  {
    when: "now",
    role: "Intern Software Engineer",
    at: "WSO2",
    cur: true,
    note: "Shipping a full-stack self-service storage feature — Go backend services and a React/TypeScript marketplace UI, delivered across six codebases and three teams.",
  },
  {
    when: "2022 — 2024",
    role: "Freelance Web Developer",
    at: "Remote",
    cur: false,
    note: "Delivered Laravel CMS and web apps for clients — owning backend architecture, deployment, and SEO performance.",
  },
  {
    when: "2023 — 2027",
    role: "BSc (Hons) Computer Science",
    at: "UCSC",
    cur: false,
    note: "Honours degree at the University of Colombo — GPA 3.66 and two Director's List awards for academic excellence.",
  },
];
---

<Layout>
  <div class="scroll-progress" aria-hidden="true"><i></i></div>

  <div class="model-bg" aria-hidden="true">
    <ModelCloud client:load src="/me.glb" lockLook={true} shiftX={1} />
  </div>

  <nav class="nav">
    <a class="brand" href="#top">
      <span class="dot"></span><span
        >thathsara<span class="ext">.dev</span></span
      ></a
    >
    <div class="links">
      {nav.map((n) => <a href={`#${n.id}`}>{n.label}</a>)}
    </div>
  </nav>

  <main class="content">
    <!-- INTRO -->
    <section id="top" class="panel hero">
      <p class="eyebrow">
        <span class="stat">available for work</span> · software engineer &amp; devops
      </p>
      <h1 class="name">Thathsara <span class="em">Madusha</span></h1>
      <p class="lede">
        Computer science undergraduate building at the intersection of
        <span class="k">systems</span> and <span class="s">cloud</span> — turning
        hard problems into software that feels effortless to use.
      </p>
      <div class="cta">
        <a class="btn primary" href="#work">view work</a>
        <a class="btn" href="#contact">get in touch</a>
      </div>
      <div class="scroll-hint">scroll <span>↓</span></div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="panel">
      <span class="kicker">/ about</span>
      <h2>Engineer, end to end.</h2>
      <p>
        I'm a computer science undergraduate at the University of Colombo and a
        software engineer at WSO2, working from Go and Rust backends to
        Kubernetes infrastructure. The figure beside this text is rendered live
        in your browser — ninety thousand points sampled from a 3D scan and spun
        by your scroll.
      </p>
      <p>
        My work lives where craft meets reliability — clear interfaces, honest
        observability, and code the next person can actually read. On the side I
        research DDoS-aware autoscaling and deep-packet-inspection evasion. I'd
        rather build one thing that holds up than ten that don't.
      </p>
    </section>

    <!-- FOCUS -->
    <section id="focus" class="panel">
      <span class="kicker">/ focus</span>
      <h2>What I work on.</h2>
      <div class="cards">
        {
          focus.map((f) => (
            <article class="card">
              <h3>{f.k}</h3>
              <p>{f.d}</p>
              <ul class="tags">
                {f.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <!-- WORK -->
    <section id="work" class="panel">
      <span class="kicker">/ selected work</span>
      <h2>Things I've built.</h2>
      <div class="work-list">
        {
          work.map((w) => (
            <article class="work-item">
              <span class="num">{w.n}</span>
              <div>
                <h3>{w.title}</h3>
                <p>{w.desc}</p>
                <ul class="meta">
                  {w.meta.map((m) => (
                    <li>{m}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- PATH -->
    <section id="path" class="panel">
      <span class="kicker">/ path</span>
      <h2>How I got here.</h2>
      <ol class="timeline">
        {
          path.map((p) => (
            <li class={p.cur ? "cur" : ""}>
              <span class="when">{p.when}</span>
              <h3>
                {p.role} <span class="at">· {p.at}</span>
              </h3>
              <p>{p.note}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="panel contact">
      <span class="kicker">/ contact</span>
      <h2>Let's build something.</h2>
      <p>Open to interesting problems and good people to build them with.</p>
      <div class="contact-links">
        <a href="mailto:thathsaramadhhusha@gmail.com">email</a>
        <a href="https://github.com/nova9" target="_blank" rel="noopener"
          >github</a
        >
        <a
          href="https://www.linkedin.com/in/thathsara-m"
          target="_blank"
          rel="noopener">linkedin</a
        >
      </div>
      <footer>
        © {new Date().getFullYear()} Thathsara Madusha — rendered live with three.js
      </footer>
    </section>
  </main>
</Layout>

<style>
  /* Pinned 3D model — right half on desktop, full-bleed backdrop on mobile */
  /* full-viewport canvas so the scatter intro is never clipped; the model
     itself is pushed to the right via the component's shiftX prop */
  .model-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  /* soft halo so the figure reads as lit, not floating in void */
  .model-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      closest-side at 74% 50%,
      rgba(232, 179, 74, 0.1),
      rgba(122, 162, 247, 0.05) 30%,
      transparent 52%
    );
    pointer-events: none;
  }
  /* manual look is locked, so no drag affordance is needed */
  .model-bg :global(canvas) {
    pointer-events: none;
    cursor: default;
  }

  /* Thin scroll-progress bar (CSS scroll-driven; degrades to hidden) */
  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 60;
    pointer-events: none;
  }
  .scroll-progress i {
    display: block;
    height: 100%;
    width: 100%;
    transform-origin: 0 50%;
    transform: scaleX(0);
    background: linear-gradient(90deg, var(--amber), var(--mint));
    animation: progress linear;
    animation-timeline: scroll(root);
  }
  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  /* Top navigation */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 28px;
    background: linear-gradient(var(--bg-0), transparent);
    font-size: 12px;
  }
  .brand {
    color: var(--amber);
    text-decoration: none;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0.02em;
  }
  .brand .ext {
    color: var(--fg-mute);
    font-weight: 400;
  }
  .brand .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 8px var(--mint);
    animation: pulse 2s infinite;
  }
  .nav .links {
    display: flex;
    gap: 18px;
  }
  .nav .links a {
    color: var(--fg-mute);
    text-decoration: none;
    transition: color 140ms;
  }
  .nav .links a:hover {
    color: var(--fg);
  }
  .nav .links a.active {
    color: var(--amber);
  }

  /* Scrolling content column — left half on desktop */
  .content {
    position: relative;
    z-index: 2;
    width: min(52%, 720px);
    padding: 0 28px;
  }

  .panel {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 96px 0;
    gap: 14px;
  }

  .kicker {
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--amber);
  }
  .panel h2 {
    font-family: var(--serif);
    font-size: clamp(30px, 4.5vw, 52px);
    line-height: 1.02;
    margin: 4px 0 8px;
    font-weight: 400;
    color: var(--fg);
  }
  .panel p {
    color: var(--fg-soft);
    font-size: 14.5px;
    line-height: 1.7;
    max-width: 52ch;
    margin: 0;
  }

  /* Hero */
  .hero .eyebrow {
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-mute);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 10px;
    max-width: none;
  }
  .hero .eyebrow .stat {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--mint);
  }
  .hero .eyebrow .stat::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 7px var(--mint);
  }
  .name {
    font-family: var(--serif);
    font-size: clamp(52px, 8vw, 104px);
    line-height: 0.92;
    letter-spacing: -0.02em;
    margin: 6px 0 18px;
    color: var(--fg);
    font-weight: 400;
  }
  .name .em {
    font-style: italic;
    color: var(--amber);
  }
  .lede {
    font-size: 16.5px !important;
    max-width: 46ch !important;
  }
  .lede .k {
    color: var(--amber);
  }
  .lede .s {
    color: var(--mint);
  }

  .cta {
    display: flex;
    gap: 12px;
    margin-top: 26px;
  }
  .btn {
    padding: 10px 20px;
    border-radius: 3px;
    border: 1px solid var(--line-strong);
    color: var(--fg-soft);
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.04em;
    transition: all 160ms;
  }
  .btn:hover {
    border-color: var(--amber);
    color: var(--fg);
  }
  .btn.primary {
    background: var(--amber);
    color: var(--bg-0);
    border-color: var(--amber);
    font-weight: 600;
  }
  .btn.primary:hover {
    filter: brightness(1.08);
  }

  .scroll-hint {
    margin-top: 48px;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-mute);
  }
  .scroll-hint span {
    display: inline-block;
    animation: bob 1.6s ease-in-out infinite;
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  /* Focus cards */
  .cards {
    display: grid;
    gap: 12px;
    margin-top: 12px;
  }
  .card {
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg-1) 78%, transparent);
    backdrop-filter: blur(6px);
    border-radius: 4px;
    padding: 16px 18px;
    transition: border-color 160ms;
  }
  .card:hover {
    border-color: var(--line-strong);
  }
  .card h3 {
    margin: 0 0 6px;
    font-size: 13px;
    color: var(--mint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .card p {
    font-size: 13px;
  }
  .tags,
  .meta {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 12px 0 0;
  }
  .tags li,
  .meta li {
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 2px;
    background: var(--bg-3);
    color: var(--fg-soft);
    letter-spacing: 0.04em;
  }

  /* Work list */
  .work-list {
    display: flex;
    flex-direction: column;
    margin-top: 8px;
  }
  .work-item {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 14px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  .work-item .num {
    font-family: var(--serif);
    font-size: 22px;
    color: var(--amber);
  }
  .work-item h3 {
    margin: 0 0 6px;
    font-size: 17px;
    color: var(--fg);
    font-weight: 600;
  }
  .work-item p {
    font-size: 13px;
  }

  /* Timeline */
  .timeline {
    list-style: none;
    margin: 12px 0 0;
    padding-left: 26px;
    border-left: 1px solid var(--line);
  }
  .timeline li {
    position: relative;
    padding: 0 0 26px;
  }
  .timeline li::before {
    content: "";
    position: absolute;
    left: -32px;
    top: 6px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg-0);
    border: 2px solid var(--amber);
  }
  .timeline li.cur::before {
    background: var(--amber);
    box-shadow: 0 0 12px var(--amber);
    animation: pulse 1.6s infinite;
  }
  .timeline .when {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-mute);
  }
  .timeline h3 {
    margin: 4px 0 4px;
    font-size: 15px;
    color: var(--fg);
    font-weight: 600;
  }
  .timeline h3 .at {
    color: var(--amber);
    font-weight: 400;
  }
  .timeline p {
    font-size: 12.5px;
  }

  /* Contact */
  .contact-links {
    display: flex;
    gap: 20px;
    margin-top: 22px;
  }
  .contact-links a {
    color: var(--fg);
    text-decoration: none;
    font-size: 14px;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
    transition:
      border-color 160ms,
      color 160ms;
  }
  .contact-links a:hover {
    color: var(--amber);
    border-color: var(--amber);
  }
  .contact footer {
    margin-top: 56px;
    font-size: 10.5px;
    color: var(--fg-faint);
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  /* Tablet / mobile: model becomes a faint backdrop, content goes full width */
  @media (max-width: 900px) {
    .model-bg {
      width: 100vw;
      opacity: 0.28;
    }
    .model-bg :global(canvas) {
      pointer-events: none;
    }
    .content {
      width: 100%;
      padding: 0 22px;
    }
    .content::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -1;
      background: linear-gradient(90deg, var(--bg-0) 30%, transparent);
      pointer-events: none;
    }
    .panel {
      min-height: auto;
      padding: 80px 0;
    }
    #top {
      min-height: 100vh;
    }
    .nav .links {
      gap: 12px;
      font-size: 11px;
    }
  }
  @media (max-width: 560px) {
    .nav {
      padding: 12px 16px;
    }
    .nav .links {
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 10px;
      font-size: 10px;
    }
  }
</style>

<script>
  // Scrollspy: highlight the nav link for the section currently in view.
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>(".nav .links a"),
  ];
  const byId = new Map(links.map((a) => [a.getAttribute("href")!.slice(1), a]));
  const obs = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          links.forEach((l) => l.classList.remove("active"));
          byId.get((e.target as HTMLElement).id)?.classList.add("active");
        }
      }
    },
    { rootMargin: "-45% 0px -45% 0px" },
  );
  document
    .querySelectorAll("main.content section[id]")
    .forEach((s) => obs.observe(s));
</script>
