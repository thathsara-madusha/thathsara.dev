---
import Layout from '../layouts/Layout.astro';
import ModelCloud from '../components/islands/ModelCloud.svelte';
---

<Layout>
  <main class="stage">
    <ModelCloud client:load src="/me.glb" />
  </main>
</Layout>

<style>
  .stage {
    position: fixed;
    inset: 0;
    background: radial-gradient(1100px 800px at 50% 45%, #0e131c, var(--bg-0) 72%);
  }
</style>
